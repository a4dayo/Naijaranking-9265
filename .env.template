# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# NaijaRank — sessions and identity
# Signs session tokens and keys the identity hash kept after erasure.
# Set once and never rotate casually: changing it breaks erase-and-revote protection.
SESSION_SECRET=
# Email OTP delivery (Resend). Required in production — without it no codes are sent.
RESEND_API_KEY=
OTP_FROM_EMAIL=

# NaijaRank — trusting the edge
# (On Cloudflare these are set in packages/web/wrangler.jsonc; set them here only for other hosts.)
# Header your edge overwrites with the real client IP (e.g. cf-connecting-ip behind Cloudflare).
CLIENT_IP_HEADER=
# Otherwise: number of proxies in front of the app; the client IP is read this many entries from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Header your edge stamps with the caller's ASN, if any (e.g. cf-asn via a transform rule).
ASN_HEADER=
# Extra origins allowed to call the API (comma-separated). The app's own origin is always allowed.
ALLOWED_ORIGINS=
PUBLIC_BASE_URL=
