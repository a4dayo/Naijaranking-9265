{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:push:safe": "bun --env-file=../../.env scripts/db-push.ts",
    "db:copy": "bun scripts/copy-data.ts",
    "dev:worker": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/tanstack-query": "^1.14.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/node": "^25.3.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.1-rc",
    "vite": "^7.3.1",
    "wrangler": "^4.149.0"
  }
}
