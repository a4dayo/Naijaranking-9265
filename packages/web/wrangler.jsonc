// Cloudflare Workers config for NaijaRank. Deployed by .github/workflows/deploy.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naijarank",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // node:crypto, node:async_hooks and process.env for the existing API code.
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA. /api/* runs the Worker; every other unknown path falls back
  // to index.html so client-side routes (/b/:slug, /admin, ...) load.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Plain settings. Secrets (DATABASE_URL, DATABASE_AUTH_TOKEN, SESSION_SECRET,
  // RESEND_API_KEY) are set with `wrangler secret put` — never in this file.
  "vars": {
    "NODE_ENV": "production",
    // Cloudflare overwrites this header with the real client IP on every request.
    "CLIENT_IP_HEADER": "cf-connecting-ip",
    // Stamped by src/worker.ts from request.cf.asn; client values are replaced.
    "ASN_HEADER": "x-nr-edge-asn",
    "OTP_FROM_EMAIL": "NaijaRank <onboarding@resend.dev>"
  },

  // Background jobs. Keep in step with CRON_JOBS in src/worker.ts.
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "7 * * * *", "23 2 * * *"]
  },

  // Shared rate-limit counters (see RateLimiter in src/worker.ts).
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],

  "observability": { "enabled": true }
}
